generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Directory: carriers, drivers, vehicles ============

model Carrier {
  id           String    @id @default(cuid())
  name         String
  inn          String
  // роль исполнителя рейса: CARRIER — перевозит сам (заказ-заявка на перевозку),
  // FORWARDER — экспедитор, организует перевозку (поручение экспедитору)
  role         String    @default("CARRIER")
  kpp          String    @default("") // КПП — для поиска ящика в Диадоке (ИНН + КПП)
  phone        String    @default("") // контактный телефон перевозчика — в ЭТрН
  diadocBoxId  String    @default("") // ящик перевозчика в Диадоке (находится по ИНН при отправке ЭТрН)
  contractNo   String
  contractDate String
  access       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt // для инкрементальной выгрузки в 1С
  drivers      Driver[]
  trucks       Truck[]
  trailers     Trailer[]
  bids         Bid[]
  wonRequests  Request[] @relation("winner")
  users        User[]    @relation("carrierUser")
}

// ============ Auth: пользователи платформы (логин + пароль) ============

/**
 * Пользователи для входа на платформу (экран входа + /api/auth/*).
 * Роль задаёт права на платформе (система прав, Task 109):
 * 'admin'  — администрация: профили и доступы, прямое редактирование базы данных;
 * 'logist' — логист АЭМЗ: площадка, торги, сверка, реестры;
 * 'carrier'— перевозчик/экспедитор: кабинет компании.
 * У перевозчика carrierId связывает учётку с его кабинетом.
 */
model User {
  id             String          @id @default(cuid())
  login          String          @unique
  name           String
  passwordHash   String // scrypt: "salt:hash"
  // версия сессий: растёт при сбросе пароля, смене роли или компании — прежние входы сразу недействительны
  sessionVersion Int             @default(0)
  role           String // 'admin' | 'logist' | 'carrier'
  carrierId      String?
  // должность (набор прав внутри контура роли); null — должность контура по умолчанию
  templateId     String?
  template       AccessTemplate? @relation(fields: [templateId], references: [id])
  // личные исключения сверх должности (разрешить / запретить одно право)
  exceptions     PermException[]
  // УСТАРЕЛО (Task 112/113): прежние личные права. Читаются только один раз — при переносе
  // в должности и исключения (src/lib/permissions.ts → ensureAccess); удалить в следующей версии.
  profileEditOwn String?
  permOverrides  String?
  carrier        Carrier?        @relation("carrierUser", fields: [carrierId], references: [id])
  createdAt      DateTime        @default(now())
  notifications  Notification[]
  profile        Profile?
  tickets        Ticket[]
  ticketMessages TicketMessage[]
}

/**
 * Должность — набор прав внутри контура (роли учётной записи): «Ведущий логист»,
 * «Диспетчер», «Аудитор»… Настраивается администрацией в «Профилях и доступах».
 * Права вне контура в должность не попадают (проверка на сервере).
 */
model AccessTemplate {
  id          String         @id @default(cuid())
  contour     String // 'admin' | 'logist' | 'carrier'
  name        String
  description String         @default("")
  // должность для новых учёток контура (ровно одна на контур)
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  perms       TemplatePerm[]
  users       User[]

  @@unique([contour, name])
}

model TemplatePerm {
  templateId String
  key        String // ключ права из каталога src/lib/perm-catalog.ts
  template   AccessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, key])
}

/**
 * Личное исключение: одно право разрешено (allow) или запрещено (deny) пользователю
 * сверх его должности. Причина обязательна; после expiresAt исключение не действует.
 */
model PermException {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  effect    String // 'allow' | 'deny'
  reason    String
  expiresAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  @@unique([userId, key])
}

/**
 * Проформа учётной записи (Task 109): персональные данные пользователя —
 * заполняются самим пользователем в разделе «Профиль», редактируются администрацией.
 * У перевозчика companyName/inn/kpp/phone синхронизируются с карточкой компании (Carrier).
 */
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  fullName    String   @default("") // ФИО (как в документах)
  position    String   @default("") // должность
  phone       String   @default("") // рабочий телефон
  email       String   @default("") // рабочая почта
  // — проформа перевозчика/экспедитора (реквизиты кабинета компании) —
  companyName String   @default("") // наименование организации
  inn         String   @default("") // ИНН
  kpp         String   @default("") // КПП
  address     String   @default("") // юридический адрес
  director    String   @default("") // руководитель (подписант документов)
  contactName String   @default("") // контактное лицо по заявкам и обращениям
  note        String   @default("") // примечание (реквизиты договора, банковские детали и пр.)
  updatedAt   DateTime @updatedAt
}

/**
 * Персональное уведомление пользователя (Task 69). Создаётся сервером при событиях,
 * значимых для конкретной роли: логисту — о ставках, экипажах и готовых документах;
 * перевозчику — о победе, перебитой ставке, возврате/подтверждении документов и закрытии рейса.
 * Доставляется колокольчиком в шапке; реал-тайм — через шину ws-service (notifyLive).
 */
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String // BID_PLACED | BID_OUTBID | AUCTION_FINISHED | WINNER_AWARDED | CREW_ASSIGNED | DOCS_READY | DOCS_RETURNED | DOCS_CONFIRMED | TRIP_CLOSED | REQUEST_DELETED
  title     String
  body      String
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Driver {
  id                 String   @id @default(cuid())
  carrierId          String
  carrier            Carrier  @relation(fields: [carrierId], references: [id])
  fullName           String
  birthDate          String
  passport           String
  phone              String   @default("—") // телефон водителя
  birthPlace         String   @default("—") // место рождения (для 1С и пропуска в порт)
  address            String   @default("—") // адрес регистрации / место жительства (для пропуска в порт)
  citizenship        String   @default("—") // гражданство (для 1С)
  passportIssuedBy   String   @default("—") // кем выдан паспорт (для 1С)
  passportIssuedDate String   @default("—") // дата выдачи паспорта (для 1С)
  position           String   @default("—") // должность (для 1С)
  // принадлежность (Task 62): OWNED — собственный штат, HIRED — наёмный от ИП/ООО, LEASE — аренда/лизинг
  ownershipType      String   @default("OWNED")
  ownerName          String   @default("—") // собственник / контрагент (ИП / ООО «Название»)
  leaseContract      String   @default("—") // договор-основание (для аренды/лизинга)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Truck {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id])
  brand         String
  plate         String
  vin           String
  sts           String
  techTill      String   @default("—") // техосмотр (диагностическая карта) до
  owner         String
  color         String   @default("—") // цвет кабины/тягача
  // принадлежность (Task 62): OWNED — собственный парк, HIRED — наёмный (ИП/ООО), LEASE — аренда/лизинг
  ownershipType String   @default("OWNED")
  leaseContract String   @default("—") // договор-основание (для аренды/лизинга)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Trailer {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id])
  plate         String
  sts           String
  type          String
  techTill      String   @default("—") // техосмотр до
  color         String   @default("—") // цвет прицепа
  owner         String   @default("—") // собственник прицепа
  // принадлежность (Task 62): OWNED — собственный парк, HIRED — наёмный (ИП/ООО), LEASE — аренда/лизинг
  ownershipType String   @default("OWNED")
  leaseContract String   @default("—") // договор-основание (для аренды/лизинга)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

/**
 * Фото/документы записей справочника (Task 54): паспорт и регистрация водителя,
 * фото ТС и СТС, фото прицепа и СТС. Сохраняются при допуске записи через
 * «Подать документы», показываются в «Справочниках» по иконке фото
 * в модальном окне предосмотра с кнопкой «Скачать фото».
 */
model DirectoryPhoto {
  id        String   @id @default(cuid())
  kind      String // driver | truck | trailer
  refId     String // id записи справочника (Driver/Truck/Trailer)
  label     String // человекочитаемое название слота («Паспорт: стр. с фото», «Фото ТС»…)
  fileName  String
  dataUri   String
  /**
   * статус документа записи (Task 62): LOADED — загружен, NEEDS_REVIEW — требует проверки
   */
  status    String   @default("LOADED")
  createdAt DateTime @default(now())

  @@index([kind, refId])
}

// ============ Directory: cargos (единый справочник грузов) ============

/**
 * Справочник грузов — единственный источник названий груза для заявок.
 * Раньше груз писали вручную в каждой заявке («Труба стальная», «трубы»…),
 * из-за чего один и тот же груз встречался под разными именами.
 * Теперь заявка ссылается на запись справочника (cargoTypeId), а `Request.cargo`
 * хранит денормализованное имя из этой записи — оно всегда одинаковое.
 */
model CargoType {
  id        String    @id @default(cuid())
  name      String    @unique // «Металлоконструкции» — эталонное имя груза
  category  String    @default("Прочее") // группа груза: Металлопрокат, Оборудование…
  truckType String    @default("Тент") // рекомендуемый тип ТС (Тент/Реф/Изотерм/Борт)
  dangerous Boolean   @default(false) // опасный груз (ADR) — признак для документов
  createdAt DateTime  @default(now())
  requests  Request[]
}

// ============ Requests (auctions) / trips ============

model Request {
  id                 String         @id @default(cuid())
  number             String         @unique
  fromPoint          String
  toPoint            String
  cargo              String // денормализованное имя груза из справочника (CargoType.name)
  cargoTypeId        String?
  cargoType          CargoType?     @relation(fields: [cargoTypeId], references: [id])
  /**
   * комментарий для исполнителя (Task 64)
   */
  comment            String         @default("")
  /**
   * логист, создавший заявку (Task 66 — колонка «Логист / Создатель» в реестре заявок)
   */
  createdBy          String         @default("—")
  /**
   * документ-основание в 1С («ЗП-0012 от 28.10.2026»), если черновик пришёл через
   * POST /api/integration/1c/requests — ключ идемпотентности: повтор не создаёт дубль
   */
  onecRef            String?        @unique
  tonnage            Float
  truckType          String
  mode               String // AUCTION | CLOSED
  startRate          Float
  bestRate           Float?
  status             String         @default("PUBLISHED") // DRAFT | PUBLISHED | AWARDED | DOCS_REVIEW | AT_LOGIST | CONFIRMED | CLOSED | DELETED
  loadDate           String
  loadWindow         String
  deadline           DateTime?
  winnerId           String?
  winner             Carrier?       @relation("winner", fields: [winnerId], references: [id])
  driverId           String?
  truckId            String?
  trailerId          String?
  /**
   * Исполнитель по данной заявке (Task 109): CARRIER — перевозчик (заказ-заявка),
   * FORWARDER — экспедитор (поручение). Выбирает перевозчик при назначении экипажа;
   * null — работает роль компании-победителя (Carrier.role).
   */
  executorRole       String?
  /**
   * Транспорт по заявке (Task 109): OWNED — транспорт в собственности (по умолчанию),
   * HIRED — наёмный, LEASE — аренда/лизинг. Указывает перевозчик при назначении экипажа.
   */
  transportOwnership String         @default("OWNED")
  passPackage        Boolean        @default(false)
  etrnStatus         String         @default("NONE") // NONE | SENT | SIGNED
  /**
   * комментарий логиста к сверки/отклонению (Task 62)
   */
  verifyComment      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  bids               Bid[]
  documents          Document[]
  files              RequestFile[]
  edoDocuments       EdoDocument[]
  events             Event[]
  notifications      Notification[]
}

/**
 * Обмен документами по заявке без почты (Task 109):
 * — перевозчик/экспедитор загружает логисту «Доверенность» (POA) и «Заявку» (REQUEST_DOC);
 * — логист выкладывает документы для перевозчика (FOR_CARRIER) — например, комплект
 * для экспедитора, которому нужны документы от АЭМЗ.
 * Файлы отдаются защищённой ссылкой /api/files/request-file/<id> с проверкой прав.
 */
model RequestFile {
  id             String   @id @default(cuid())
  requestId      String
  request        Request  @relation(fields: [requestId], references: [id])
  kind           String // POA | REQUEST_DOC | FOR_CARRIER
  fileName       String
  dataUri        String
  sizeBytes      Int      @default(0)
  uploadedBy     String // carrier | logist
  uploadedByName String
  createdAt      DateTime @default(now())

  @@index([requestId])
}

/**
 * Обращение в поддержку платформы (Task 109): перевозчик/экспедитор описывает
 * проблему, логист и администрация отвечают в ветке сообщений.
 * Вложения (документы и медиа) — на сообщения обращения, суммарный лимит 10 МБ на обращение.
 */
model Ticket {
  id            String          @id @default(cuid())
  // сквозной номер обращения (назначается при создании: max+1 — SQLite не умеет autoincrement вне @id)
  number        Int             @unique
  subject       String
  category      String          @default("other") // docs | auction | payment | edo | tech | other
  status        String          @default("OPEN") // OPEN | ANSWERED | CLOSED
  authorId      String
  author        User            @relation(fields: [authorId], references: [id])
  authorName    String // денормализованно — для списка без join
  carrierId     String? // кабинет перевозчика, если автор из компании
  carrierName   String?
  sizeTotal     Int             @default(0) // суммарный размер вложений обращения, байт (лимит 10 МБ)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      TicketMessage[]
}

/**
 * Сообщение в обращении: вопрос автора или ответ платформы (логист/администрация)
 */
model TicketMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id])
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  authorName  String
  authorRole  String // carrier | logist | admin
  staff       Boolean            @default(false) // ответ платформы
  body        String
  createdAt   DateTime           @default(now())
  attachments TicketAttachment[]
}

/**
 * Вложение сообщения обращения: документ или медиа (данные в dataUri, отдаётся ссылкой)
 */
model TicketAttachment {
  id        String        @id @default(cuid())
  messageId String
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  mime      String        @default("")
  isImage   Boolean       @default(false)
  sizeBytes Int           @default(0)
  dataUri   String
  createdAt DateTime      @default(now())

  @@index([messageId])
}

model Bid {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id])
  carrierId String
  carrier   Carrier  @relation(fields: [carrierId], references: [id])
  amount    Float
  isWinner  Boolean  @default(false)
  /**
   * ставка отозвана — агент добровольно снялся с заявки (Task 52)
   */
  withdrawn Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Document {
  id         String   @id @default(cuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id])
  type       String // PASSPORT_PHOTO | PASSPORT_REG | STS | REQUEST_DOC | POA | ATTACHMENT
  fileName   String
  dataUri    String
  status     String   @default("PENDING") // PENDING | PASSED | REUPLOAD | REJECTED | MANUAL
  quality    Float?
  engine     String?
  fields     String? // JSON: recognized fields
  confidence String? // JSON: per-field confidence 0..1
  issues     String? // JSON: list of issue strings
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/**
 * Документ ЭДО рейса (Task 76, раздел «Подписать ЭДО»).
 * Наш случай — цепочка АЭМЗ (грузоотправитель) → экспедитор → перевозчик:
 * — kind POA («Доверенность экспедитору») и ORDER («Поручение экспедитору»)
 * создаёт АЭМЗ — это его обязанность перед экспедитором;
 * — kind ETRN («Транспортная накладная / ЭТрН») появляется при подтверждении
 * рейса, kind ACT («Акт оказанных услуг») — после закрытия рейса.
 * Каждая сторона подписывает своей КЭП: aemz* — КЭП логиста АЭМЗ,
 * party* — подпись контрагента (экспедитор или перевозчик) через ЭДО-оператора.
 */
model EdoDocument {
  id              String    @id @default(cuid())
  requestId       String
  request         Request   @relation(fields: [requestId], references: [id])
  kind            String // POA | ORDER | ETRN | ACT
  party           String // EXPEDITOR | CARRIER
  number          String // номер документа (ДОВ-1042, ПОР-1042, ЭТрН 1042, АКТ-1042)
  payload         String // JSON: реквизиты для рендера скана и подписантов
  aemzSigned      Boolean   @default(false)
  aemzSignedAt    DateTime?
  aemzSigner      String?
  partySigned     Boolean   @default(false)
  partySignedAt   DateTime?
  partySigner     String?
  // ——— Диадок: ЭТрН через API оператора ЭДО (src/lib/diadoc) ———
  diadocBoxId     String? // ящик АЭМЗ, из которого отправлен титул Т1
  diadocMessageId String? // MessageId сообщения с титулами Т1/Т2 (он же kl-id перевозки)
  diadocEntityId  String? // EntityId титула Т1
  diadocStage     String? // kl-status — этап перевозки по данным Диадока (r-wait-carrier-sign, on-the-way, completed…)
  etrnUid         String? // УИД ТрН (mt-id) — присваивает ГИС ЭПД после регистрации Т1
  gisStatus       String? // последний статус обработки в ГИС ЭПД
  gisError        String? // текст ошибки Диадока или ГИС ЭПД, если она была
  etrnInput       String? // JSON: данные ЭТрН, которые логист подтвердил при отправке Т1
  diadocSentAt    DateTime?
  diadocSyncedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([requestId])
}

/**
 * Состояние интеграции с Диадоком (одна запись id = "main").
 * refresh_token ротируется при каждом обмене — новое значение сохраняется здесь,
 * иначе через 30 дней интеграция остановится. Переменная DIADOC_REFRESH_TOKEN
 * нужна только для первого запуска.
 */
model DiadocState {
  id                   String    @id @default("main")
  refreshToken         String?
  accessToken          String?
  accessTokenExpiresAt DateTime?
  eventsIndexKey       String? // позиция в ленте событий ящика АЭМЗ (BoxEvent.IndexKey)
  lastSyncAt           DateTime?
  lastError            String?
  updatedAt            DateTime  @updatedAt
}

/**
 * Журнал событий платформы (Task 76, раздел «Журнал событий» у логиста).
 * Сюда пишутся: бизнес-события всех заявок и кабинетов (вход/выход, ставки,
 * документы, ЭДО, интеграция с 1С), предупреждения и ошибки сервера —
 * в том числе необработанные (через instrumentation.ts → onRequestError)
 * и ошибки клиентской части (эндпоинт /api/platform-log/client).
 * level: INFO | WARN | ERROR.
 */
model PlatformLog {
  id            String   @id @default(cuid())
  level         String   @default("INFO") // INFO | WARN | ERROR
  type          String // вид события: LOGIN | LOGOUT | REQUEST_CREATED | BID_PLACED | … | SERVER_ERROR | CLIENT_ERROR
  source        String   @default("platform") // источник: api/requests/action, auth/login, browser, 1c/etrn…
  actorLogin    String? // кто выполнил действие (логин учётки)
  actorName     String? // имя пользователя
  actorRole     String? // logist | carrier
  requestId     String?
  requestNumber String? // денормализованно, для ленты без join
  carrierName   String? // перевозчик, которого касается событие
  message       String
  meta          String? // JSON: подробности (стек ошибки, параметры, код статуса)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([level, createdAt])
}

/**
 * Журнал событий. carrierId — чьё это событие (ставка, отзыв, победа): перевозчик
 * видит только свои события и общие (публикация, продление, повышение ставки),
 * логист — все.
 */
model Event {
  id        String   @id @default(cuid())
  requestId String?
  request   Request? @relation(fields: [requestId], references: [id])
  carrierId String?
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([carrierId])
}

// ============ Settings: confidence thresholds and rules ============

model Setting {
  id           String @id @default("main")
  confReupload Float  @default(0.6) // ниже — поле не принимается, решает человек
  confReject   Float  @default(0.6) // от этой уверенности расхождение с заявкой = отказ (отдельно от confReupload)
  confAuto     Float  @default(0.95)
  minQuality   Float  @default(60)
  rules        String @default("{}")
}

/**
 * УСТАРЕЛО (Task 111): прежняя матрица «роль × право». Заменена должностями
 * (AccessTemplate); читается только один раз — при переносе (ensureAccess).
 * Удалить в следующей версии вместе с User.permOverrides и User.profileEditOwn.
 */
model RolePerm {
  role      String // 'admin' | 'logist' | 'carrier'
  key       String // ключ права из каталога (draft:create, request:delete, edo:sign…)
  allowed   Boolean
  updatedAt DateTime @updatedAt

  @@id([role, key])
}
