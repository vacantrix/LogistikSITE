// Модуль формы «Заказы грузоотправителей» (АЭМЗ / Учет металла) — кнопка «в Веб-Логистик»
// рядом с «Путевые листы»: отмеченные рейсы уходят на веб-платформу АЭМЗ Логистика черновиками
// заявок (поиск перевозчика через торги), «Еще → Обновить статусы Веб-Логистик» забирает
// обратно статус, перевозчика и экипаж.
//
// Платформа: POST /api/integration/1c/requests (черновик), GET /api/integration/1c/requests?onecRef= (статус).
// Как выглядит и работает — симулятор docs/1c/simulator/index.html; контракт API — docs/1c/README.md.
//
// Как подключить:
//  1. В форме создайте две команды:
//       «ВВебЛогистик» (заголовок «в Веб-Логистик», картинка — глобус, отображение «Картинка и текст»);
//       «ОбновитьСтатусыВебЛогистик» (заголовок «Обновить статусы Веб-Логистик»).
//     Первую перетащите в командную панель таблицы рейсов сразу после кнопки «Путевые листы»,
//     вторую — в подменю «Еще» той же панели.
//  2. Добавьте в таблицу рейсов колонку ВебЛогистик (Строка, 100) — номер и статус заявки на платформе.
//  3. Сверьте имена в функции КолонкиРейсов() и в ИмяТаблицыРейсов() со своей формой.
//  4. Укажите адрес платформы и API-ключ в АдресПлатформы() и КлючAPI() (в рабочей базе — константами).

#Область НастройкиПодключения

&НаСервереБезКонтекста
Функция АдресПлатформы()
        // Домен платформы без https:// и без слеша в конце
        Возврат "logistika.your-domain.ru"; // ЗАМЕНИТЕ
КонецФункции

&НаСервереБезКонтекста
Функция КлючAPI()
        // Значение ONEC_API_KEY из .env на сервере платформы (не короче 24 символов)
        Возврат "ВАШ_КЛЮЧ_ИЗ_ONEC_API_KEY"; // ЗАМЕНИТЕ
КонецФункции

&НаСервереБезКонтекста
Функция ТочкаПогрузки()
        Возврат "Краснодарский край, г. Абинск, ул. Промышленная, д. 4";
КонецФункции

#КонецОбласти

#Область ИменаФормы

// Имя реквизита формы — таблицы рейсов (нижняя таблица «п/п, Дата погрузки, …»).
// Модуль рассчитан на таблицу значений формы (ДанныеФормыКоллекция). Если рейсы показаны
// динамическим списком, отмеченные строки берите из Элементы.<Таблица>.ВыделенныеСтроки.
&НаКлиентеНаСервереБезКонтекста
Функция ИмяТаблицыРейсов()
        Возврат "Рейсы"; // ЗАМЕНИТЕ на имя своей таблицы
КонецФункции

// Имена колонок таблицы рейсов. Сверьте со своей формой.
&НаКлиентеНаСервереБезКонтекста
Функция КолонкиРейсов()
        К = Новый Структура;
        К.Вставить("Отметка",              "Отметка");
        К.Вставить("НомерПП",              "НомерПП");
        К.Вставить("ДатаПогрузки",         "ДатаПогрузки");
        К.Вставить("ДатаВыгрузки",         "ДатаВыгрузки");
        К.Вставить("ТранспортнаяКомпания", "ТранспортнаяКомпания");
        К.Вставить("НомерТС",              "НомерТС");
        К.Вставить("Прицеп",               "Прицеп");
        К.Вставить("Водитель",             "Водитель");
        К.Вставить("Контрагент",           "Контрагент");
        К.Вставить("Заказчик",             "Заказчик");
        К.Вставить("Спецификация",         "Спецификация");
        К.Вставить("ПунктРазгрузки",       "ПунктРазгрузки");
        К.Вставить("Продукция",            "Продукция");
        К.Вставить("Количество",           "Количество"); // тонны
        К.Вставить("СтавкаЗаТонну",        "СтавкаЗаТонну"); // необязательная колонка: ставка за тонну для торгов; колонки может не быть — тогда стартовую ставку задаст логист
        К.Вставить("ВебЛогистик",          "ВебЛогистик"); // новая колонка: номер и статус на платформе
        Возврат К;
КонецФункции

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ВВебЛогистик(Команда)

        Рейсы = ОтмеченныеРейсы();
        Если Рейсы.Количество() = 0 Тогда
                ПоказатьПредупреждение(, "Отметьте рейсы, которые нужно отправить в Веб-Логистик.");
                Возврат;
        КонецЕсли;

        Текст = "Отправить в Веб-Логистик рейсов: " + Рейсы.Количество() + "?" + Символы.ПС
                + "На платформе появятся черновики заявок; логист опубликует их на торги." + Символы.ПС
                + "Повторная отправка рейса дубль не создаёт.";
        Оповещение = Новый ОписаниеОповещения("ВВебЛогистикЗавершение", ЭтотОбъект, Рейсы);
        ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Веб-Логистик");

КонецПроцедуры

&НаКлиенте
Процедура ВВебЛогистикЗавершение(Ответ, Рейсы) Экспорт

        Если Ответ <> КодВозвратаДиалога.Да Тогда
                Возврат;
        КонецЕсли;

        Результат = ОтправитьРейсыНаСервере(Рейсы);
        Если Результат.Отправлено > 0 Или Результат.Повторно > 0 Тогда
                ПоказатьОповещениеПользователя("Веб-Логистик", , Результат.Текст, БиблиотекаКартинок.Информация);
        КонецЕсли;
        Если Результат.Ошибки <> "" Тогда
                ПоказатьПредупреждение(, "Часть рейсов не отправлена:" + Символы.ПС + Символы.ПС + Результат.Ошибки);
        КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусыВебЛогистик(Команда)

        Результат = ОбновитьСтатусыНаСервере();
        Если Результат.Ошибка <> "" Тогда
                ПоказатьПредупреждение(, Результат.Ошибка);
        Иначе
                ПоказатьОповещениеПользователя("Веб-Логистик", , Результат.Текст, БиблиотекаКартинок.Информация);
        КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбменСПлатформой

// Номера п/п отмеченных рейсов (рейс = машина; в таблице у него может быть несколько строк продукции)
&НаКлиенте
Функция ОтмеченныеРейсы()
        К = КолонкиРейсов();
        Номера = Новый Массив;
        Для Каждого СтрокаТаблицы Из ЭтотОбъект[ИмяТаблицыРейсов()] Цикл
                Если СтрокаТаблицы[К.Отметка] И Номера.Найти(СтрокаТаблицы[К.НомерПП]) = Неопределено Тогда
                        Номера.Добавить(СтрокаТаблицы[К.НомерПП]);
                КонецЕсли;
        КонецЦикла;
        Возврат Номера;
КонецФункции

&НаСервере
Функция ОтправитьРейсыНаСервере(Номера)

        Результат = Новый Структура("Отправлено, Повторно, Текст, Ошибки", 0, 0, "", "");
        К = КолонкиРейсов();
        Созданы = Новый Массив;
        Повторы = Новый Массив;

        Для Каждого НомерПП Из Номера Цикл
                Строки = СтрокиРейса(НомерПП);
                Ответ = ВыполнитьЗапрос("POST", "/api/integration/1c/requests", ДанныеРейсаДляПлатформы(Строки));
                Если Ответ.Ошибка <> "" Тогда
                        Результат.Ошибки = Результат.Ошибки + "Рейс №" + НомерПП + ": " + Ответ.Ошибка + Символы.ПС;
                        Прервать; // нет связи — остальные тоже не уйдут
                КонецЕсли;
                Если (Ответ.КодСостояния = 201 Или Ответ.КодСостояния = 200) И ТипЗнч(Ответ.Данные) = Тип("Соответствие") Тогда
                        Заявка = Ответ.Данные["data"];
                        Для Каждого СтрокаРейса Из Строки Цикл
                                СтрокаРейса[К.ВебЛогистик] = Заявка["number"] + " · " + Заявка["statusRu"];
                        КонецЦикла;
                        Если Заявка["duplicate"] = Истина Тогда
                                Результат.Повторно = Результат.Повторно + 1;
                                Повторы.Добавить("№" + НомерПП + " → " + Заявка["number"]);
                        Иначе
                                Результат.Отправлено = Результат.Отправлено + 1;
                                Созданы.Добавить("№" + НомерПП + " → " + Заявка["number"]);
                        КонецЕсли;
                Иначе
                        Результат.Ошибки = Результат.Ошибки + "Рейс №" + НомерПП + ": " + ТекстОшибкиПлатформы(Ответ) + Символы.ПС;
                КонецЕсли;
        КонецЦикла;

        Если Созданы.Количество() > 0 Тогда
                Результат.Текст = "Создано черновиков: " + СтрСоединить(Созданы, ", ") + Символы.ПС;
        КонецЕсли;
        Если Повторы.Количество() > 0 Тогда
                Результат.Текст = Результат.Текст + "Уже были на платформе: " + СтрСоединить(Повторы, ", ");
        КонецЕсли;
        Возврат Результат;

КонецФункции

&НаСервере
Функция ОбновитьСтатусыНаСервере()

        Результат = Новый Структура("Текст, Ошибка", "", "");
        К = КолонкиРейсов();
        Обработаны = Новый Массив;
        Обновлено = 0;

        Для Каждого СтрокаТаблицы Из ЭтотОбъект[ИмяТаблицыРейсов()] Цикл
                Если ПустаяСтрока(СтрокаТаблицы[К.ВебЛогистик]) Или Обработаны.Найти(СтрокаТаблицы[К.НомерПП]) <> Неопределено Тогда
                        Продолжить;
                КонецЕсли;
                Обработаны.Добавить(СтрокаТаблицы[К.НомерПП]);
                Строки = СтрокиРейса(СтрокаТаблицы[К.НомерПП]);
                Адрес = "/api/integration/1c/requests?onecRef="
                        + КодироватьСтроку(КлючРейса(Строки[0]), СпособКодированияСтроки.КодировкаURL);
                Ответ = ВыполнитьЗапрос("GET", Адрес);
                Если Ответ.Ошибка <> "" Тогда
                        Результат.Ошибка = Ответ.Ошибка;
                        Возврат Результат;
                КонецЕсли;
                Если Ответ.КодСостояния <> 200 Или ТипЗнч(Ответ.Данные) <> Тип("Соответствие") Тогда
                        Результат.Ошибка = ТекстОшибкиПлатформы(Ответ);
                        Возврат Результат;
                КонецЕсли;
                Если Ответ.Данные["data"].Количество() = 0 Тогда
                        Продолжить;
                КонецЕсли;

                Заявка = Ответ.Данные["data"][0];
                Победитель = Заявка["winner"];
                Экипаж = Заявка["crew"];
                Для Каждого СтрокаРейса Из Строки Цикл
                        СтрокаРейса[К.ВебЛогистик] = Заявка["number"] + " · " + Заявка["statusRu"];
                        // перевозчик и экипаж, выбранные на платформе, переносятся в рейс (пустые поля не затираем)
                        Если Победитель <> Неопределено И ПустаяСтрока(Строка(СтрокаРейса[К.ТранспортнаяКомпания])) Тогда
                                СтрокаРейса[К.ТранспортнаяКомпания] = Победитель["name"];
                        КонецЕсли;
                        Если Экипаж <> Неопределено Тогда
                                СтрокаРейса[К.Водитель] = Экипаж["driver"]["fullName"];
                                Если Экипаж["truck"] <> Неопределено Тогда
                                        СтрокаРейса[К.НомерТС] = Экипаж["truck"]["plate"];
                                КонецЕсли;
                                Если Экипаж["trailer"] <> Неопределено Тогда
                                        СтрокаРейса[К.Прицеп] = Экипаж["trailer"]["plate"];
                                КонецЕсли;
                        КонецЕсли;
                КонецЦикла;
                Обновлено = Обновлено + 1;
        КонецЦикла;

        Результат.Текст = ?(Обновлено > 0, "Обновлено рейсов: " + Обновлено, "Рейсов, отправленных в Веб-Логистик, нет");
        Возврат Результат;

КонецФункции

// Строки таблицы, относящиеся к одному рейсу (номер п/п)
&НаСервере
Функция СтрокиРейса(НомерПП)
        К = КолонкиРейсов();
        Отбор = Новый Структура(К.НомерПП, НомерПП);
        Возврат ЭтотОбъект[ИмяТаблицыРейсов()].НайтиСтроки(Отбор);
КонецФункции

// Ключ рейса на платформе: номер п/п и дата погрузки — повтор того же рейса не создаёт дубль
&НаСервере
Функция КлючРейса(СтрокаРейса)
        К = КолонкиРейсов();
        Возврат "Рейс №" + Формат(СтрокаРейса[К.НомерПП], "ЧГ=0") + " от " + Формат(СтрокаРейса[К.ДатаПогрузки], "ДФ=dd.MM.yyyy");
КонецФункции

// Черновик заявки по рейсу: груз и вес — сумма строк продукции, комментарий — состав рейса
&НаСервере
Функция ДанныеРейсаДляПлатформы(Строки)

        К = КолонкиРейсов();
        Первая = Строки[0];
        Вес = 0;
        Состав = Новый Массив;
        Для Каждого СтрокаРейса Из Строки Цикл
                Вес = Вес + СтрокаРейса[К.Количество];
                Состав.Добавить(Строка(СтрокаРейса[К.Продукция]) + " — " + Формат(СтрокаРейса[К.Количество], "ЧДЦ=3") + " т");
        КонецЦикла;
        Получатель = ?(ЗначениеЗаполнено(Первая[К.Заказчик]), Первая[К.Заказчик], Первая[К.Контрагент]);

        // Ставка за тонну из заказа: если в таблице рейсов есть колонка «СтавкаЗаТонну» и она заполнена —
        // уходит на платформу стартовой ставкой торгов; нет колонки — 0, ставку задаст логист при публикации
        СтавкаЗаТонну = 0;
        Попытка
                ЗначениеСтавки = Первая[К.СтавкаЗаТонну];
                Если ЗначениеЗаполнено(ЗначениеСтавки) И ЗначениеСтавки > 0 Тогда
                        СтавкаЗаТонну = ЗначениеСтавки;
                КонецЕсли;
        Исключение
                // колонки нет в этой форме — работаем без ставки
        КонецПопытки;

        Данные = Новый Структура;
        Данные.Вставить("oneC_number", КлючРейса(Первая));
        Данные.Вставить("fromPoint",   ТочкаПогрузки());
        Данные.Вставить("toPoint",     СокрЛП(Строка(Первая[К.ПунктРазгрузки])));
        Данные.Вставить("cargo",       ГрузПлатформы(Строка(Первая[К.Продукция])));
        Данные.Вставить("tonnage",     Вес);
        Данные.Вставить("loadDate",    Формат(Первая[К.ДатаПогрузки], "ДФ=yyyy-MM-dd"));
        Данные.Вставить("loadWindow",  "08:00–17:00");
        Данные.Вставить("startRate",   СтавкаЗаТонну); // ставка за тонну из 1С; 0 — задаст логист при публикации
        Данные.Вставить("comment",     СтрСоединить(Состав, "; ") + ". Грузополучатель " + Строка(Получатель)
                + ". " + Строка(Первая[К.Спецификация]) + ". Выгрузка " + Формат(Первая[К.ДатаВыгрузки], "ДФ=dd.MM.yyyy"));
        Возврат Данные;

КонецФункции

// Номенклатура → груз из справочника грузов платформы («Перевозка готовой продукции - …»)
&НаСервереБезКонтекста
Функция ГрузПлатформы(Номенклатура)
        Н = НРег(Номенклатура);
        Если СтрНайти(Н, "проволок") > 0 Тогда
                Вид = "проволока";
        ИначеЕсли СтрНайти(Н, "моток") > 0 Тогда
                Вид = "моток";
        ИначеЕсли СтрНайти(Н, "катанк") > 0 Тогда
                Вид = "катанка";
        ИначеЕсли СтрНайти(Н, "арматур") > 0 Тогда
                Вид = "арматура";
        Иначе
                Вид = "пруток";
        КонецЕсли;
        Возврат "Перевозка готовой продукции - " + Вид;
КонецФункции

// HTTP-запрос к платформе. Возвращает структуру: КодСостояния, Данные (Соответствие), Текст, Ошибка.
&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(Метод, Адрес, Тело = Неопределено)

        Результат = Новый Структура("КодСостояния, Данные, Текст, Ошибка", 0, Неопределено, "", "");

        Заголовки = Новый Соответствие;
        Заголовки.Вставить("X-API-Key", КлючAPI());
        Заголовки.Вставить("Accept", "application/json");

        Запрос = Новый HTTPЗапрос(Адрес, Заголовки);
        Если Тело <> Неопределено Тогда
                ЗаписьJSON = Новый ЗаписьJSON;
                ЗаписьJSON.УстановитьСтроку();
                ЗаписатьJSON(ЗаписьJSON, Тело);
                Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
                Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
        КонецЕсли;

        Попытка
                SSL = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
                Соединение = Новый HTTPСоединение(АдресПлатформы(), 443, , , , 30, SSL);
                Если Метод = "POST" Тогда
                        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
                Иначе
                        Ответ = Соединение.Получить(Запрос);
                КонецЕсли;
        Исключение
                Результат.Ошибка = "Не удалось связаться с платформой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
                Возврат Результат;
        КонецПопытки;

        Результат.КодСостояния = Ответ.КодСостояния;
        Результат.Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
        Попытка
                ЧтениеJSON = Новый ЧтениеJSON;
                ЧтениеJSON.УстановитьСтроку(Результат.Текст);
                // в Соответствие: ключи вроде "to" (маршрут) не читаются в Структуру
                Результат.Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
                ЧтениеJSON.Закрыть();
        Исключение
                // не JSON — текст ответа останется в Результат.Текст
        КонецПопытки;

        Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиПлатформы(Ответ)
        Если ТипЗнч(Ответ.Данные) = Тип("Соответствие") И Ответ.Данные["error"] <> Неопределено Тогда
                Пояснение = Ответ.Данные["error"];
        Иначе
                Пояснение = Лев(Ответ.Текст, 300);
        КонецЕсли;
        Если Ответ.КодСостояния = 401 Тогда
                Возврат "Платформа не приняла API-ключ (401): проверьте КлючAPI() и ONEC_API_KEY на сервере.";
        ИначеЕсли Ответ.КодСостояния = 503 Тогда
                Возврат "Интеграция с 1С на платформе выключена (503): на сервере не задан ONEC_API_KEY.";
        КонецЕсли;
        Возврат "Ошибка " + Ответ.КодСостояния + ": " + Пояснение;
КонецФункции

#КонецОбласти
