// Модуль формы документа 1С «Заявка на перевозку» — отправка черновика на веб-платформу
// АЭМЗ Логистика и получение статуса торгов обратно.
//
// Платформа: POST /api/integration/1c/requests (черновик), GET /api/integration/1c/requests?onecRef= (статус).
// Подробности и проверка без 1С — docs/1c/README.md и docs/1c/onec-check.mjs.
//
// Как подключить:
//  1. Добавьте в форму документа две команды: «ОтправитьНаПлатформу» и «СтатусНаПлатформе»
//     (действия — одноимённые процедуры ниже) и вынесите их кнопками на форму.
//  2. Сверьте имена реквизитов документа в функции ДанныеЗаявкиДляПлатформы()
//     (Откуда, Куда, Груз, ВесГруза, ТипКузова, ДатаПогрузки, Ставка, Комментарий) со своими.
//  3. Укажите адрес платформы и API-ключ в функциях АдресПлатформы() и КлючAPI().
//     В рабочей базе лучше хранить их в константах, а не в коде.
//
// HTTP-запросы выполняются на сервере: ключ не попадает на клиент, и код работает в любом клиенте.

#Область НастройкиПодключения

&НаСервереБезКонтекста
Функция АдресПлатформы()
	// Домен платформы без https:// и без слеша в конце (тот, что указан в Caddyfile / DNS)
	Возврат "logistika.your-domain.ru"; // ЗАМЕНИТЕ
КонецФункции

&НаСервереБезКонтекста
Функция КлючAPI()
	// Значение ONEC_API_KEY из .env на сервере платформы (не короче 24 символов)
	Возврат "ВАШ_КЛЮЧ_ИЗ_ONEC_API_KEY"; // ЗАМЕНИТЕ
КонецФункции

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ОтправитьНаПлатформу(Команда)

	Если ПустаяСтрока(Объект.Откуда) Или ПустаяСтрока(Объект.Куда) Тогда
		ПоказатьПредупреждение(, "Заполните маршрут: «Откуда» и «Куда».");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ДатаПогрузки) Тогда
		ПоказатьПредупреждение(, "Заполните дату погрузки.");
		Возврат;
	КонецЕсли;
	Если НачалоДня(Объект.ДатаПогрузки) < НачалоДня(ТекущаяДата()) Тогда
		ПоказатьПредупреждение(, "Дата погрузки уже прошла — платформа не примет такую заявку.");
		Возврат;
	КонецЕсли;

	// Номер документу присваивается при записи, а он — ключ от повторной отправки
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Результат = ОтправитьНаПлатформуНаСервере();

	Если Результат.Успех Тогда
		Если Результат.ЗаписатьДокумент Тогда
			Записать(); // комментарий с номером заявки на платформе
		КонецЕсли;
		ПоказатьОповещениеПользователя("Веб-платформа", , Результат.Текст, БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьПредупреждение(, Результат.Текст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтатусНаПлатформе(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Документ ещё не записан и не отправлялся на платформу.");
		Возврат;
	КонецЕсли;

	Результат = СтатусНаПлатформеНаСервере();
	ПоказатьПредупреждение(, Результат.Текст);

КонецПроцедуры

#КонецОбласти

#Область ОбменСПлатформой

&НаСервере
Функция ОтправитьНаПлатформуНаСервере()

	Результат = Новый Структура("Успех, Текст, ЗаписатьДокумент", Ложь, "", Ложь);

	Ответ = ВыполнитьЗапрос("POST", "/api/integration/1c/requests", ДанныеЗаявкиДляПлатформы());
	Если Ответ.Ошибка <> "" Тогда
		Результат.Текст = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;

	// 201 — черновик создан; 200 — этот документ уже отправляли, платформа вернула тот же черновик
	Если (Ответ.КодСостояния = 201 Или Ответ.КодСостояния = 200) И ТипЗнч(Ответ.Данные) = Тип("Соответствие") Тогда
		Заявка = Ответ.Данные["data"];
		Результат.Успех = Истина;
		Если Ответ.КодСостояния = 201 Тогда
			Результат.Текст = "Черновик создан на платформе: № " + Заявка["number"]
				+ ". Логист опубликует его на площадке.";
			Отметка = "Отправлено на веб-платформу: № " + Заявка["number"] + " (id " + Заявка["id"] + ")";
			Если СтрНайти(Объект.Комментарий, Отметка) = 0 Тогда
				Объект.Комментарий = СокрЛП(Объект.Комментарий + Символы.ПС + Отметка);
				Результат.ЗаписатьДокумент = Истина;
			КонецЕсли;
		Иначе
			Результат.Текст = "Документ уже был отправлен ранее: заявка № " + Заявка["number"]
				+ ", статус «" + Заявка["statusRu"] + "». Повторно не создаётся.";
		КонецЕсли;
	Иначе
		Результат.Текст = ТекстОшибкиПлатформы(Ответ);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СтатусНаПлатформеНаСервере()

	Результат = Новый Структура("Текст", "");

	Адрес = "/api/integration/1c/requests?onecRef="
		+ КодироватьСтроку(КлючДокумента(), СпособКодированияСтроки.КодировкаURL);
	Ответ = ВыполнитьЗапрос("GET", Адрес);
	Если Ответ.Ошибка <> "" Тогда
		Результат.Текст = Ответ.Ошибка;
		Возврат Результат;
	КонецЕсли;
	Если Ответ.КодСостояния <> 200 Или ТипЗнч(Ответ.Данные) <> Тип("Соответствие") Тогда
		Результат.Текст = ТекстОшибкиПлатформы(Ответ);
		Возврат Результат;
	КонецЕсли;

	Если Ответ.Данные["data"].Количество() = 0 Тогда
		Результат.Текст = "На платформе нет заявки по этому документу — отправьте её кнопкой «Отправить на платформу».";
		Возврат Результат;
	КонецЕсли;

	Заявка = Ответ.Данные["data"][0];
	Текст = "Заявка № " + Заявка["number"] + ": " + Заявка["statusRu"] + ".";
	Победитель = Заявка["winner"];
	Если Победитель <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Перевозчик: " + Победитель["name"] + " (ИНН " + Победитель["inn"] + ")";
	КонецЕсли;
	ЛучшаяСтавка = Заявка["rates"]["best"];
	Если ЛучшаяСтавка <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Лучшая ставка: " + Формат(ЛучшаяСтавка, "ЧДЦ=0") + " ₽/т";
	КонецЕсли;
	Экипаж = Заявка["crew"];
	Если Экипаж <> Неопределено Тогда
		Текст = Текст + Символы.ПС + "Водитель: " + Экипаж["driver"]["fullName"];
		Если Экипаж["truck"] <> Неопределено Тогда
			Текст = Текст + ", ТС " + Экипаж["truck"]["brand"] + " " + Экипаж["truck"]["plate"];
		КонецЕсли;
	КонецЕсли;
	Результат.Текст = Текст;

	Возврат Результат;

КонецФункции

// Данные документа в формате платформы. Имена реквизитов сверьте со своим документом.
&НаСервере
Функция ДанныеЗаявкиДляПлатформы()

	Данные = Новый Структура;
	Данные.Вставить("oneC_number", КлючДокумента());
	Данные.Вставить("fromPoint",   СокрЛП(Объект.Откуда));  // адрес погрузки — как есть, с улицей и домом
	Данные.Вставить("toPoint",     СокрЛП(Объект.Куда));    // адрес выгрузки
	Данные.Вставить("cargo",       СокрЛП(Строка(Объект.Груз))); // наименование как в справочнике грузов платформы
	Данные.Вставить("tonnage",     Объект.ВесГруза);        // тонны, 0 < вес <= 200
	Данные.Вставить("truckType",   СокрЛП(Строка(Объект.ТипКузова))); // «Тент» или «Борт»
	Данные.Вставить("loadDate",    Формат(Объект.ДатаПогрузки, "ДФ=yyyy-MM-dd"));
	Данные.Вставить("loadWindow",  "09:00–18:00");          // окно погрузки, если хранится в документе — подставьте
	Данные.Вставить("startRate",   Объект.Ставка);          // ВАЖНО: рублей за ТОННУ; 0 — ставку задаст логист
	Данные.Вставить("comment",     СокрЛП(Объект.Комментарий));
	Возврат Данные;

КонецФункции

// Ключ документа для платформы: номер 1С повторяется каждый год, поэтому добавляем дату.
&НаСервере
Функция КлючДокумента()
	Возврат СокрЛП(Объект.Номер) + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy");
КонецФункции

// HTTP-запрос к платформе. Возвращает структуру: КодСостояния, Данные, Текст, Ошибка.
// Данные — JSON ответа в виде Соответствия: в Структуру ПрочитатьJSON не читает ключи,
// совпадающие с ключевыми словами языка (например, "to" в маршруте route).
&НаСервереБезКонтекста
Функция ВыполнитьЗапрос(Метод, Адрес, Тело = Неопределено)

	Результат = Новый Структура("КодСостояния, Данные, Текст, Ошибка", 0, Неопределено, "", "");

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-API-Key", КлючAPI());
	Заголовки.Вставить("Accept", "application/json");

	Запрос = Новый HTTPЗапрос(Адрес, Заголовки);
	Если Тело <> Неопределено Тогда
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Тело);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Попытка
		// Проверка сертификата сервера по корневым сертификатам Windows/Linux (Let's Encrypt от Caddy проходит)
		SSL = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
		Соединение = Новый HTTPСоединение(АдресПлатформы(), 443, , , , 30, SSL);
		Если Метод = "POST" Тогда
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;
	Исключение
		Результат.Ошибка = "Не удалось связаться с платформой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = Ответ.КодСостояния;
	Результат.Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Результат.Текст);
		Результат.Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
	Исключение
		// не JSON (например, страница ошибки прокси) — текст ответа останется в Результат.Текст
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиПлатформы(Ответ)

	Если ТипЗнч(Ответ.Данные) = Тип("Соответствие") И Ответ.Данные["error"] <> Неопределено Тогда
		Пояснение = Ответ.Данные["error"];
	Иначе
		Пояснение = Лев(Ответ.Текст, 300);
	КонецЕсли;

	Если Ответ.КодСостояния = 401 Тогда
		Возврат "Платформа не приняла API-ключ (401): проверьте КлючAPI() и ONEC_API_KEY на сервере.";
	ИначеЕсли Ответ.КодСостояния = 503 Тогда
		Возврат "Интеграция с 1С на платформе выключена (503): на сервере не задан ONEC_API_KEY.";
	КонецЕсли;
	Возврат "Платформа ответила ошибкой " + Ответ.КодСостояния + ": " + Пояснение;

КонецФункции

#КонецОбласти
