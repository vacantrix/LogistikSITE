# Скопируйте в .env и заполните. Файл .env в git не попадает.

# База SQLite (путь относительно prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# Секрет подписи сессий — обязателен в проде, не короче 32 символов:  openssl rand -hex 32
# Тот же секрет нужен ws-service (проверка входа при подключении к real-time шине).
AUTH_SECRET=
# 1 — кука сессии без флага Secure (только для демо-стенда без HTTPS)
COOKIE_INSECURE=

# Интеграция с 1С: ключ не короче 24 символов; без него маршруты /api/integration/1c/* отвечают 503
ONEC_API_KEY=
# сайты, с которых браузер может обращаться к /api/integration/1c/{ping,requests} — через запятую,
# например HTML-симулятор 1С на GitHub Pages: https://vacantrix.github.io  (пусто — CORS выключен)
ONEC_CORS_ORIGINS=

# Распознавание документов: локальный OCR (mini-services/paddle-ocr) через шлюз mini-services/ocr-service
OCR_SERVICE_URL=http://127.0.0.1:3020
PADDLE_OCR_URL=http://127.0.0.1:3031/ocr
# общий токен между платформой и OCR-сервисами (необязательно, если всё на одном сервере)
OCR_SERVICE_TOKEN=

# 1 — демо-образцы (SVG) проверяются имитацией. Только для демо-стенда.
DEMO_SAMPLES=
# пароль демо-пользователей при заполнении базы (prisma/seed.ts); пусто — случайный, печатается в консоль
SEED_PASSWORD=
# показать демо-доступы на экране входа (тот же пароль, что SEED_PASSWORD). Только для демо-стенда.
NEXT_PUBLIC_DEMO_PASSWORD=

# real-time шина (mini-services/ws-service): на стенде — через шлюз Caddy (Caddyfile).
# Локально без шлюза: запустите шину `npm run ws` (Node, Bun не нужен) и укажите
#   NEXT_PUBLIC_WS_URL=http://localhost:3003   — браузер подключается к шине напрямую
#   WS_ALLOWED_ORIGINS=http://localhost:3000   — адрес платформы, с которого шина принимает подключения
WS_NOTIFY_TOKEN=
WS_ALLOWED_ORIGINS=
NEXT_PUBLIC_WS_URL=

# Диадок: ЭТрН через API оператора ЭДО (src/lib/diadoc). Без DIADOC_CLIENT_ID интеграция выключена.
# Доступ: заявка на diadoc.ru/integrations/api → Кабинет интегратора (client_id, client_secret, refresh-токен)
DIADOC_API_URL=https://diadoc-api-staging.kontur.ru
DIADOC_OIDC_URL=https://identity.kontur.ru
DIADOC_CLIENT_ID=
DIADOC_CLIENT_SECRET=
# первый refresh-токен; дальше платформа хранит ротированный токен в базе (DiadocState)
DIADOC_REFRESH_TOKEN=
# ящик АЭМЗ (GUID); пусто — первый ящик сервисной учётной записи
DIADOC_BOX_ID=
# 1 — тестовая подпись Диадока (только тестовые ящики); 0 — Т1 подписывают своей КЭП в веб-интерфейсе Диадока
DIADOC_TEST_SIGNATURE=
# период фоновой сверки статусов ЭТрН, секунд (0 — только кнопкой «Обновить статусы»)
DIADOC_SYNC_INTERVAL_SEC=180
# реквизиты АЭМЗ для титула Т1, которых нет в ящике Диадока
EDO_SHIPPER_PHONE=
EDO_LOADING_ZIP=353320
EDO_LOADING_REGION=23
EDO_LOADING_CITY=Абинск
EDO_LOADING_STREET=Промышленная
EDO_LOADING_BUILDING=4
EDO_SIGNER_POSITION=Начальник отдела логистики
EDO_SIGNER_LAST_NAME=
EDO_SIGNER_FIRST_NAME=
EDO_SIGNER_MIDDLE_NAME=
# кто отпускает груз со склада (по умолчанию — подписант)
EDO_LOADER_POSITION=
EDO_LOADER_LAST_NAME=
EDO_LOADER_FIRST_NAME=
EDO_LOADER_MIDDLE_NAME=
